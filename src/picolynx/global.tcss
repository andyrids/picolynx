# Theme colours are in `picolynx.__main__.GALAXY_THEME`

* {
    scrollbar-background: $surface-darken-1;
    scrollbar-background-active: $surface-darken-1;
    scrollbar-background-hover: $surface-darken-1;
    scrollbar-color: $primary 10%;
    scrollbar-color-active: $primary;
    scrollbar-color-hover: $primary 80%;
    scrollbar-size-horizontal: 1;
    scrollbar-size-vertical: 1;

    &:focus {
        scrollbar-color: $primary 50%;
    }
}

Checkbox {
    min-width: 20;
    width: 100%;
    &:focus {
        background: $surface;
        background-tint: $surface;
    }
    &:focus > .toggle--label {
        background: $surface;
        text-style: none;
    }

}

# Round borders around all Container & ItemGrid widgets
Container, ItemGrid {
    border: round $accent 40%;
    border-title-align: center;
    border-title-color: $text-accent 50%;
    border-title-style: bold;
}


# Generic styling for all DataTable widgets
DataTable {
    background: $background;
    margin: 0 0;
    min-height: 5;
    overflow-y: scroll;
    padding: 0 1;
    width: 100%;
    
    &:focus {
        background-tint: $background 100%;
    }
    & > .datatable--header {
        background: $surface;
        color: $text-success;
    }
    &:focus > .datatable--header {
        background: $surface;
        background-tint: $surface 100%;
    }
}

Footer {
    border: round;
    background: $background;
    height: 1;
}

# Custom TUIHeader widget
TUIHeader {
    border: none;
    color: $text-primary;
    height: auto;
    margin: 0 1;
    padding: 1 1;
    & > #header-hostname {
        color: $text-muted;
        dock: right;
    }
}

# Main TUI container for all layout widgets
#container-main {
    border: none;
    grid-columns: auto 1fr 1fr 1fr 1fr;
    grid-gutter: 1;
    grid-rows: auto;
    grid-size: 5 3;
    layout: grid;
    margin: 0 1;
    overflow-y: scroll;
    padding: 0;
    scrollbar-size-vertical: 0;
}

# Bottom-left connected devices container
#container-devices {
    column-span: 3;
    height: 100%;
    row-span: 1;
}

# Middle-left WSL distro container
#container-distros {
    column-span: 3;
}

# Top-right PnP events container
#container-events {
    column-span: 2;
    row-span: 5;
}

# Set border & border-title styling on focus-within
#container-devices, #container-distros, #container-events, #container-filters {
    &:focus-within {
        border: round $accent 100%;
        border-title-color: $foreground;
        border-title-style: bold;
    }
}

# Top-left checkbox container
#container-filters {
    align: center middle;
    column-span: 3;
    grid-gutter: 1;
    grid-size: 3;
    padding: 0 1;
}